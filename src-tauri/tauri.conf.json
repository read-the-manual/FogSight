{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "雾见",
  "version": "0.1.0",
  "identifier": "io.github.read-the-manual.wujian",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "雾见",
        "width": 1120,
        "height": 740,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
